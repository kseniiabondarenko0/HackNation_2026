DJANGO_SECRET_KEY=
# 0 = tryb produkcyjny (wymaga własnego DJANGO_SECRET_KEY); 1 tylko do lokalnego rozwoju
DJANGO_DEBUG=0
# Required: set your own DJANGO_SECRET_KEY before Docker startup.
# Discovery defaults to free seed domains + links. Keys alone do not enable search APIs.
DISCOVERY_PROVIDERS=seeds,links
DISCOVERY_AUTO_APPROVE=1
SEARXNG_URL=
BRAVE_API_KEY=
DISCOVERY_AUTO_HOURS=24
# AI: use free accounts without billing. These local caps do not determine the provider's account tier.
# Keys stay on the server; never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_CALLS_PER_DAY=250
GEMINI_MAX_TOKENS_PER_DAY=1000000
GEMINI_MIN_INTERVAL_S=6
# Optional fallback; configure a key only for an account in the required free plan.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_CALLS_PER_DAY=900
GROQ_MAX_TOKENS_PER_DAY=90000
GROQ_MIN_INTERVAL_S=10
LLM_PROVIDERS=gemini,groq
LLM_MAX_TEXT_CHARS=6000
LLM_MAX_CALLS_PER_RUN=60
WINDOW_MONTHS=0
