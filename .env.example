DJANGO_SECRET_KEY=change-me
# 0 = tryb produkcyjny (wymaga własnego DJANGO_SECRET_KEY); 1 tylko do lokalnego rozwoju
DJANGO_DEBUG=0
# Automatic source discovery (optional): search API + automatic run every N hours (0 = only by command)
SEARXNG_URL=
BRAVE_API_KEY=
DISCOVERY_AUTO_HOURS=24
# AI analysis on FREE tiers only (no billing). Keys stay on the server; never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Fallback when Gemini is paused: free key from console.groq.com (no card needed)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_CALLS_PER_RUN=60
WINDOW_MONTHS=0
